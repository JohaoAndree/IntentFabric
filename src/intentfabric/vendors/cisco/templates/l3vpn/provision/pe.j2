vrf definition {{ vrf_name }}
 description {{ description }}
 rd {{ rd }}
 !
 address-family ipv4
  route-target export {{ rt_export }}
  route-target import {{ rt_import }}
 exit-address-family
!
policy-map {{ qos_policy }}
 class class-default
